{
  "name": "ai-factory-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Trusted local orchestrator for AI Factory V1 GitHub user stories",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "doctor": "npm run build && node dist/src/doctor.js",
    "orchestrate": "npm run build && node dist/src/orchestrator.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
